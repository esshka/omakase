# cp .env.example .env — any provider RubyLLM supports works here.
MODEL=meta/muse-glimmer-30b
PROVIDER=openrouter
OPENROUTER_API_KEY=

# examples/memory_agent.rb embeds. OpenRouter serves embeddings, it just does not
# list the models, so the example names one on trust — override it here.
# EMBEDDING_MODEL=qwen/qwen3-embedding-4b

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_API_BASE=http://localhost:11434
